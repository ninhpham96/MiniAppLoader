<UserControl x:Class="MiniAppLoader.Views.PluginHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:MiniAppLoader.Core"
             xmlns:views="clr-namespace:MiniAppLoader.Views"
             AllowDrop="True"
             Background="{DynamicResource Hub.Background}"
             TextOptions.TextFormattingMode="Display"
             FontFamily="Segoe UI"
             FontSize="12"
             MinWidth="260">

    <UserControl.Resources>

        <views:StatusBrushConverter x:Key="StatusBrush"/>
        <views:InverseBoolToVisibilityConverter x:Key="EmptyState"/>
        <views:PositiveToVisibilityConverter x:Key="WhenPositive"/>

        <!-- Nút phẳng, chỉ nổi khối khi hover - giữ cho pane yên tĩnh lúc không thao tác. -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Hub.Text}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Hub.SurfaceHover}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Hub.Border}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Hub.SurfaceHover}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Hub.Border}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="120"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="150" MinHeight="56"/>
        </Grid.RowDefinitions>

        <!-- ==================== Thanh công cụ ==================== -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource Hub.Surface}"
                    BorderBrush="{DynamicResource Hub.Border}"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid>
                    <TextBox x:Name="SearchBox"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource Hub.Text}"
                             CaretBrush="{DynamicResource Hub.Text}"
                             Padding="7,4"
                             VerticalContentAlignment="Center"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Margin="9,0,0,0"
                               Text="Tìm plugin..."
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Hub.TextDim}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <Button Grid.Column="1" Style="{StaticResource FlatButton}" Margin="6,0,0,0"
                    Content="+ Thêm"
                    ToolTip="Chọn file .dll để nạp (hoặc kéo thả thẳng vào pane)"
                    Command="{Binding BrowseCommand}"/>

            <Button Grid.Column="2" Style="{StaticResource FlatButton}" Margin="4,0,0,0"
                    Content="Nạp lại tất cả"
                    Command="{Binding ReloadAllCommand}"/>
        </Grid>

        <!-- ==================== Danh sách plugin ==================== -->
        <Border Grid.Row="1"
                Background="{DynamicResource Hub.Surface}"
                BorderBrush="{DynamicResource Hub.Border}"
                BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                    <ItemsControl ItemsSource="{Binding VisibleSlots}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type core:PluginSlot}">
                                <Border Style="{StaticResource CardBorder}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Ellipse Grid.Row="0" Grid.Column="0"
                                                 Width="8" Height="8" Margin="0,0,7,0"
                                                 VerticalAlignment="Center"
                                                 Fill="{Binding Status, Converter={StaticResource StatusBrush}}"
                                                 ToolTip="{Binding LastError}"/>

                                        <TextBlock Grid.Row="0" Grid.Column="1"
                                                   Text="{Binding Id}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource Hub.Text}"/>

                                        <TextBlock Grid.Row="0" Grid.Column="2"
                                                   Text="{Binding Kind}"
                                                   FontSize="10"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Hub.TextDim}"/>

                                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                   Margin="0,1,0,0"
                                                   Text="{Binding DllPath}"
                                                   FontSize="10"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding DllPath}"
                                                   Foreground="{DynamicResource Hub.TextDim}"/>

                                        <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                                   Margin="0,2,0,0"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Hub.TextDim}"
                                                   Visibility="{Binding StaleLoads, Converter={StaticResource WhenPositive}}"
                                                   ToolTip="Chỉ là bộ nhớ chưa thu hồi — code đang chạy vẫn luôn là bản mới nhất. Plugin kiểu Application gần như luôn tăng dần: đo trên Revit 2026 cho thấy mỗi lần reload để lại một assembly không thu hồi được, kể cả khi plugin không dựng ribbon nào. Đây là giới hạn đã biết, không phải lỗi của bạn — reload vài chục lần thì không sao, rất nhiều thì restart Revit."
                                                   Text="{Binding StaleLoads, StringFormat={}{0} bản cũ chưa thu hồi}"/>

                                        <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                                    Orientation="Horizontal" Margin="0,4,0,0">
                                            <Button Style="{StaticResource FlatButton}" FontSize="11"
                                                    Content="Chạy"
                                                    IsEnabled="{Binding DataContext.CanRunFromHub, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    ToolTip="{Binding DataContext.RunUnavailableReason, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Command="{Binding DataContext.RunCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Style="{StaticResource FlatButton}" FontSize="11" Margin="2,0,0,0"
                                                    Content="Nạp lại"
                                                    Command="{Binding DataContext.ReloadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <CheckBox Margin="8,0,0,0" FontSize="11"
                                                      Content="auto"
                                                      VerticalAlignment="Center"
                                                      Foreground="{DynamicResource Hub.TextDim}"
                                                      ToolTip="Tự nạp lại khi file DLL thay đổi"
                                                      IsChecked="{Binding AutoReload}"/>
                                            <Button Style="{StaticResource FlatButton}" FontSize="11" Margin="8,0,0,0"
                                                    Content="Gỡ"
                                                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Margin="16"
                           Text="Chưa có plugin nào.&#10;Kéo thả một file .dll vào đây, hoặc bấm &quot;+ Thêm&quot;."
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Foreground="{DynamicResource Hub.TextDim}"
                           Visibility="{Binding HasPlugins, Converter={StaticResource EmptyState}}"/>
            </Grid>
        </Border>

        <GridSplitter Grid.Row="2" Height="5"
                      HorizontalAlignment="Stretch"
                      Background="Transparent"
                      ResizeBehavior="PreviousAndNext"/>

        <!-- ==================== Nhật ký ==================== -->
        <Border Grid.Row="3"
                Background="{DynamicResource Hub.Surface}"
                BorderBrush="{DynamicResource Hub.Border}"
                BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="8,4,4,2">
                    <TextBlock Text="Nhật ký"
                               FontSize="10" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Hub.TextDim}"/>
                    <Button Style="{StaticResource FlatButton}" FontSize="10"
                            Content="Xoá"
                            HorizontalAlignment="Right"
                            Command="{Binding ClearLogCommand}"/>
                </Grid>

                <ScrollViewer Grid.Row="1" x:Name="LogScroll" VerticalScrollBarVisibility="Auto" Padding="8,0,8,6">
                    <ItemsControl ItemsSource="{Binding Log}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Timestamp, StringFormat=HH:mm:ss}"
                                               FontFamily="Consolas" FontSize="10"
                                               Foreground="{DynamicResource Hub.TextDim}"/>
                                    <TextBlock Grid.Column="1" Margin="6,0"
                                               Text="{Binding Level}"
                                               FontFamily="Consolas" FontSize="10"
                                               Foreground="{DynamicResource Hub.Accent}"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Message}"
                                               FontFamily="Consolas" FontSize="10"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource Hub.Text}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>

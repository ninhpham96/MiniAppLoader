<!-- Palette tối, khớp theme Dark của Revit 2024+. Giữ đúng bộ key của Light.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Hub.Background"    Color="#1E1E1E"/>
    <SolidColorBrush x:Key="Hub.Surface"       Color="#2A2D2E"/>
    <SolidColorBrush x:Key="Hub.SurfaceHover"  Color="#37393B"/>
    <SolidColorBrush x:Key="Hub.Border"        Color="#3F4245"/>
    <SolidColorBrush x:Key="Hub.Text"          Color="#E6E6E6"/>
    <SolidColorBrush x:Key="Hub.TextDim"       Color="#9AA0A6"/>
    <SolidColorBrush x:Key="Hub.Accent"        Color="#60A5FA"/>

    <SolidColorBrush x:Key="Hub.Status.Idle"    Color="#6B7280"/>
    <SolidColorBrush x:Key="Hub.Status.Loaded"  Color="#4ADE80"/>
    <SolidColorBrush x:Key="Hub.Status.Pending" Color="#FBBF24"/>
    <SolidColorBrush x:Key="Hub.Status.Error"   Color="#F87171"/>
    <SolidColorBrush x:Key="Hub.Status.Removed" Color="#4B5563"/>

</ResourceDictionary>

<!-- Palette sáng. Dark.xaml phải khai ĐÚNG bộ key này — ThemeManager hoán đổi cả
     dictionary lúc chạy, thiếu key nào là view nổ ngay khi đổi theme. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Hub.Background"    Color="#F5F6F8"/>
    <SolidColorBrush x:Key="Hub.Surface"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Hub.SurfaceHover"  Color="#EEF1F6"/>
    <SolidColorBrush x:Key="Hub.Border"        Color="#D8DCE3"/>
    <SolidColorBrush x:Key="Hub.Text"          Color="#1B1F24"/>
    <SolidColorBrush x:Key="Hub.TextDim"       Color="#6B7280"/>
    <SolidColorBrush x:Key="Hub.Accent"        Color="#2563EB"/>

    <SolidColorBrush x:Key="Hub.Status.Idle"    Color="#9CA3AF"/>
    <SolidColorBrush x:Key="Hub.Status.Loaded"  Color="#16A34A"/>
    <SolidColorBrush x:Key="Hub.Status.Pending" Color="#D97706"/>
    <SolidColorBrush x:Key="Hub.Status.Error"   Color="#DC2626"/>
    <SolidColorBrush x:Key="Hub.Status.Removed" Color="#D1D5DB"/>

</ResourceDictionary>

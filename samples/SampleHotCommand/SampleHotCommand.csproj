<Project Sdk="Microsoft.NET.Sdk">

    <!-- Plugin mẫu implement CẢ IExternalCommand LẪN IHotCommand, để kiểm chứng vòng lặp
         "sửa code -> build -> tự chạy lại" mà không phải chạm chuột.

         KHÔNG khai báo .addin và KHÔNG deploy vào thư mục Addins của Revit — nó tồn tại chỉ
         để MiniAppLoader nạp từ bin này. -->
    <PropertyGroup>
        <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>true</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <EnableDynamicLoading>true</EnableDynamicLoading>
    </PropertyGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
        <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2024.*"/>
        <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2024.*"/>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
        <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2026.*"/>
        <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2026.*"/>
    </ItemGroup>

    <ItemGroup>
        <!-- IHotCommand nằm trong chính assembly loader. Private=false là BẮT BUỘC, không
             phải tối ưu: loader tìm entry point bằng Type.IsAssignableFrom, nên plugin phải
             thấy ĐÚNG instance assembly mà host đã nạp. Nếu copy MiniAppLoader.dll vào thư
             mục plugin thì trên net48 CLR có thể nạp bản thứ hai, và IsAssignableFrom trả
             về false — plugin im lặng không bao giờ được tự chạy lại.

             Tham chiếu trỏ vào bin của loader, nên phải build loader TRƯỚC khi build mẫu
             này. Cấu hình nào cũng được miễn đúng TFM: R22..R24 -> net48, R25..R27 -> net8. -->
        <Reference Include="MiniAppLoader">
            <HintPath Condition="'$(TargetFramework)' == 'net48'">..\..\source\MiniAppLoader\bin\Debug.R24\MiniAppLoader.dll</HintPath>
            <HintPath Condition="'$(TargetFramework)' != 'net48'">..\..\source\MiniAppLoader\bin\Debug.R26\MiniAppLoader.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

</Project>
